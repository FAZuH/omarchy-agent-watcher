#!/usr/bin/env bash
# Agent Watcher hook: turns one agent hook invocation into a state-file update
# plus a shell ping, or dumps the current state for the shell.
#
#   agent-watcher-hook <agent> <event>     stdin: the agent's hook JSON
#   agent-watcher-hook dump                prune dead sessions, print JSON array
#
#   agent: claude | codex | gemini | opencode
#   event: session-start | prompt | waiting | tool-done | done | session-end
#          | rename (title-only update; the session must already exist)
#
# Silent and always exit 0 on the hook path: agents treat exit codes and
# stdout as control signals. Set AGENT_WATCHER_DEBUG=1 to keep stderr.

STATE_DIR="${AGENT_WATCHER_STATE_DIR:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/omarchy-agent-watcher}"
PLUGIN_ID="io.github.5d0tal1gat0r.agent-watcher"

agent_pattern() { # ERE matched against an ancestor's cmdline (NULs -> spaces)
  case "$1" in
    claude)   printf '%s' '(^|[/ ])claude([ -]|$)' ;;
    codex)    printf '%s' '(^|[/ ])codex([ -]|$)' ;;
    gemini)   printf '%s' 'gemini' ;;
    opencode) printf '%s' '(^|[/ ])opencode([ -]|$)' ;;
    *)        printf '%s' '^$' ;;
  esac
}

cmdline_of() { tr '\0' ' ' < "/proc/$1/cmdline" 2>/dev/null; }

# Internal helper processes an agent spawns for its own background sessions.
# A hook fired from underneath one of these belongs to the agent's plumbing,
# not to a session the user opened, so it is ignored (Claude Code 2.1.x runs a
# `claude daemon` that starts `bg-pty-host` sessions and pre-warmed spares,
# each of which fires SessionStart with its own session id).
helper_pattern() { # ERE matched against an ancestor's cmdline; empty = none
  case "$1" in
    claude) printf '%s' '(^|[/ ])claude (daemon|bg-pty-host|bg-spare)( |$)|--bg-pty-host|--bg-spare' ;;
    *)      printf '%s' '' ;;
  esac
}

alive() { # alive <pid> <agent>: process exists and still looks like that agent
  [ -n "$1" ] && [ "$1" -gt 0 ] 2>/dev/null && [ -d "/proc/$1" ] || return 1
  cmdline_of "$1" | grep -Eq "$(agent_pattern "$2")"
}

# Walk the whole parent chain. Sets AGENT_PID (first ancestor whose cmdline
# matches the agent, skipping only this script itself -- an agent may well
# carry "agent-watcher" in its argv, e.g. a prompt about this plugin),
# HELPER_ANCESTOR=1 when any ancestor matches the agent's helper pattern, and,
# when need_window=1, WINDOW_ADDRESS (first ancestor that owns a Hyprland
# client, bare hex). The walk never stops early: helper processes sit above
# the agent process, so they must be seen even when the window is cached.
resolve_ancestry() { # resolve_ancestry <agent> <need_window:0|1>
  local agent="$1" need_window="$2" pid=$$ pattern helpers clients="" cmd
  pattern=$(agent_pattern "$agent")
  helpers=$(helper_pattern "$agent")
  AGENT_PID=0
  WINDOW_ADDRESS=""
  HELPER_ANCESTOR=0
  if [ "$need_window" = 1 ]; then
    clients=$(hyprctl clients -j 2>/dev/null | jq -r '.[] | "\(.pid) \(.address)"' 2>/dev/null)
  fi
  while [ -n "$pid" ] && [ "$pid" -gt 1 ] 2>/dev/null; do
    cmd=$(cmdline_of "$pid")
    if [ "$AGENT_PID" = 0 ] && [ "${cmd#*agent-watcher-hook}" = "$cmd" ] && printf '%s' "$cmd" | grep -Eq "$pattern"; then
      AGENT_PID=$pid
    fi
    if [ -n "$helpers" ] && [ "$HELPER_ANCESTOR" = 0 ] && printf '%s' "$cmd" | grep -Eq "$helpers"; then
      HELPER_ANCESTOR=1
    fi
    if [ -n "$clients" ] && [ -z "$WINDOW_ADDRESS" ]; then
      WINDOW_ADDRESS=$(printf '%s\n' "$clients" | awk -v p="$pid" '$1 == p { sub(/^0x/, "", $2); print tolower($2); exit }')
    fi
    pid=$(awk '/^PPid:/ { print $2 }' "/proc/$pid/status" 2>/dev/null)
  done
}

ping_shell() {
  local cli
  cli=$(command -v omarchy-shell 2>/dev/null)
  [ -n "$cli" ] || cli=/usr/share/omarchy/bin/omarchy-shell
  [ -x "$cli" ] || return 0
  OMARCHY_PATH="${OMARCHY_PATH:-/usr/share/omarchy}" "$cli" -q "$PLUGIN_ID" refresh >/dev/null 2>&1 || true
}

# True when the process was re-parented to init / the systemd user manager:
# its terminal (and the shell in it) is gone. Agents that ignore SIGHUP —
# OpenCode does — linger this way after their window is closed.
orphaned() { # orphaned <pid>
  local ppid comm
  ppid=$(awk '/^PPid:/ { print $2 }' "/proc/$1/status" 2>/dev/null)
  [ -n "$ppid" ] || return 1
  [ "$ppid" -le 1 ] 2>/dev/null && return 0
  comm=$(cat "/proc/$ppid/comm" 2>/dev/null)
  [ "$comm" = systemd ]
}

# Bare-hex addresses of the Hyprland windows that currently exist, one per
# line; fetched lazily (once per dump) and only when a session needs it.
WINDOWS_FETCHED=0
WINDOWS=""
window_exists() { # window_exists <bare-hex-address>
  if [ "$WINDOWS_FETCHED" = 0 ]; then
    WINDOWS_FETCHED=1
    WINDOWS=$(hyprctl clients -j 2>/dev/null | jq -r '.[].address' 2>/dev/null | sed 's/^0x//' | tr 'A-F' 'a-f')
    # No compositor answer: assume windows still exist rather than prune.
    [ -n "$WINDOWS" ] || WINDOWS="?"
  fi
  [ "$WINDOWS" = "?" ] && return 0
  printf '%s\n' "$WINDOWS" | grep -qx "$1"
}

dump() {
  # No jq means we cannot tell a broken state file from a good one, so prune
  # nothing: deleting every session here would lose live sessions for good.
  command -v jq >/dev/null 2>&1 || { printf '[]\n'; return 0; }
  mkdir -p "$STATE_DIR" 2>/dev/null
  local f agent pid win out
  local files=()
  for f in "$STATE_DIR"/*.json; do
    [ -e "$f" ] || continue
    # Unreadable or already gone (a concurrent session-end): skip, never delete.
    [ -r "$f" ] || continue
    if ! agent=$(jq -er '.agent' "$f" 2>/dev/null); then
      # Only delete when jq ran against a file that is still there: that is a
      # real parse failure, not a race.
      [ -e "$f" ] && rm -f "$f"
      continue
    fi
    pid=$(jq -r '.agentPid // 0' "$f" 2>/dev/null)
    if [ "${pid:-0}" -gt 0 ] 2>/dev/null && ! alive "$pid" "$agent"; then rm -f "$f"; continue; fi
    # The window it was started in is gone and no live process vouches for
    # it — either we never learned the pid, or the agent survived the hangup
    # and now hangs off init/systemd (OpenCode does that): the user closed the
    # terminal. Not a session anyone can reach any more; drop it. A tmux/nohup
    # session that never had a window keeps its empty address and is left alone.
    win=$(jq -r '.windowAddress // ""' "$f" 2>/dev/null)
    if [ -n "$win" ] && { [ "${pid:-0}" -le 0 ] 2>/dev/null || orphaned "$pid"; } && ! window_exists "$win"; then
      rm -f "$f"; continue
    fi
    files+=("$f")
  done
  if [ "${#files[@]}" -eq 0 ]; then printf '[]\n'; return 0; fi
  # jq -s fails wholesale if one file vanished since the loop; fall back to
  # reading them one by one rather than reporting "no sessions at all".
  if out=$(jq -s 'map(select(type == "object"))' "${files[@]}" 2>/dev/null); then
    printf '%s\n' "$out"
  else
    { for f in "${files[@]}"; do [ -r "$f" ] && jq -c . "$f" 2>/dev/null; done; } | jq -s 'map(select(type == "object"))'
  fi
}

if [ "${1:-}" = dump ]; then
  dump
  exit 0
fi

# ---- hook path: from here on nothing reaches stdout, and we always exit 0.
exec 1>/dev/null
[ "${AGENT_WATCHER_DEBUG:-0}" = 1 ] || exec 2>/dev/null

AGENT="${1:-}"
EVENT="${2:-}"
case "$AGENT" in claude|codex|gemini|opencode) ;; *) exit 0 ;; esac
case "$EVENT" in
  session-start) STATE=idle ;;
  prompt)        STATE=working ;;
  waiting)       STATE=waiting ;;
  tool-done)     STATE=working ;;
  done)          STATE=done ;;
  session-end)   STATE="" ;;
  rename)        STATE="" ;;
  *) exit 0 ;;
esac

INPUT=$(cat 2>/dev/null)
printf '%s' "$INPUT" | jq -e . >/dev/null 2>&1 || INPUT='{}'
SESSION_ID=$(printf '%s' "$INPUT" | jq -r '.session_id // .sessionID // .sessionId // empty' 2>/dev/null)
CWD=$(printf '%s' "$INPUT" | jq -r '.cwd // .directory // empty' 2>/dev/null)
# Optional session name supplied by the agent (OpenCode sends its session
# title); other agents leave it empty and the shell falls back to the window
# title / project name.
TITLE=$(printf '%s' "$INPUT" | jq -r '.title // empty' 2>/dev/null)
# Reporters that watch sessions beyond their own terminal (OpenCode v2's
# shared service) mark events windowless: the row keeps whatever window an
# earlier owner registered, but a fresh one gets none instead of the
# reporter's own terminal, and no agent pid to age out on.
WINDOWLESS=$(printf '%s' "$INPUT" | jq -r '.windowless // false' 2>/dev/null)

# Gemini fires Notification for more than permissions; only ToolPermission blocks.
if [ "$AGENT" = gemini ] && [ "$EVENT" = waiting ]; then
  nt=$(printf '%s' "$INPUT" | jq -r '.notification_type // empty' 2>/dev/null)
  [ -z "$nt" ] || [ "$nt" = ToolPermission ] || exit 0
fi

AGENT_PID=0
WINDOW_ADDRESS=""
if [ -z "$SESSION_ID" ]; then
  resolve_ancestry "$AGENT" 0
  SESSION_ID="pid$AGENT_PID"
fi
SAFE_ID=$(printf '%s' "$SESSION_ID" | tr -c 'A-Za-z0-9._-' '_')
FILE="$STATE_DIR/$AGENT-$SAFE_ID.json"

if [ "$EVENT" = session-end ]; then
  rm -f "$FILE"
  ping_shell
  exit 0
fi

PREV_STATE=""; PREV_WINDOW=""; PREV_PID=0; PREV_CWD=""; PREV_TITLE=""
if [ -f "$FILE" ]; then
  { read -r PREV_STATE; read -r PREV_WINDOW; read -r PREV_PID; read -r PREV_CWD; read -r PREV_TITLE; } < <(
    jq -r '(.state // ""), (.windowAddress // ""), ((.agentPid // 0)|tostring), (.cwd // ""), (.title // "")' "$FILE" 2>/dev/null)
fi
# rename touches only the title: state, timestamps and lastEvent stay put so
# the shell does not mistake it for new activity (which would re-arm a blink
# the user already acknowledged). Unknown sessions are ignored.
if [ "$EVENT" = rename ]; then
  [ -f "$FILE" ] || exit 0
  [ "$TITLE" != "$PREV_TITLE" ] || exit 0
  TMP="$FILE.tmp.$$"
  if jq --arg title "$TITLE" '.title = $title' "$FILE" > "$TMP" 2>/dev/null; then
    mv -f "$TMP" "$FILE" 2>/dev/null
    ping_shell
  fi
  rm -f "$TMP" 2>/dev/null
  exit 0
fi
# tool-done only matters while blocked on a permission.
if [ "$EVENT" = tool-done ] && [ "$PREV_STATE" != waiting ]; then exit 0; fi

# A windowless report never touches window attribution (it comes from a
# terminal that is not the session's); any other report re-resolves and, when
# it finds a window, takes it over -- the terminal now showing the session is
# its real owner.
if [ "$WINDOWLESS" = true ]; then
  WINDOW_ADDRESS="$PREV_WINDOW"
  AGENT_PID="${PREV_PID:-0}"
else
  resolve_ancestry "$AGENT" 1
  [ -n "$WINDOW_ADDRESS" ] || WINDOW_ADDRESS="$PREV_WINDOW"
fi
# A session spawned by the agent's own background plumbing is not the user's:
# ignore it and drop anything an earlier event of it may have written.
if [ "${HELPER_ANCESTOR:-0}" = 1 ]; then
  rm -f "$FILE"
  exit 0
fi
[ "$AGENT_PID" != 0 ] || AGENT_PID="${PREV_PID:-0}"
case $AGENT_PID in ''|*[!0-9]*) AGENT_PID=0 ;; esac
[ -n "$CWD" ] || CWD="$PREV_CWD"
[ -n "$TITLE" ] || TITLE="$PREV_TITLE"

mkdir -p "$STATE_DIR" 2>/dev/null || exit 0
NOW=$(date +%s)
TMP="$FILE.tmp.$$"
if jq -n --arg agent "$AGENT" --arg sessionId "$SESSION_ID" --arg state "$STATE" --arg cwd "$CWD" \
      --argjson agentPid "${AGENT_PID:-0}" --arg windowAddress "$WINDOW_ADDRESS" \
      --argjson updatedAt "$NOW" --arg lastEvent "$EVENT" --arg title "$TITLE" \
      '{agent: $agent, sessionId: $sessionId, state: $state, cwd: $cwd, agentPid: $agentPid,
        windowAddress: $windowAddress, updatedAt: $updatedAt, lastEvent: $lastEvent, title: $title}' > "$TMP" 2>/dev/null; then
  mv -f "$TMP" "$FILE" 2>/dev/null
fi
rm -f "$TMP" 2>/dev/null
ping_shell
exit 0
